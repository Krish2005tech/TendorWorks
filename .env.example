# Defaults run entirely locally with clearly marked synthetic demonstration data.
TENDER_MODE=demo
TENDER_DATABASE_URL=sqlite:///var/tender.db
TENDER_DATA_DIR=var
TENDER_DATABASE_DIR=database
TENDER_DATABASE_TENANT=demo
TENDER_SEED_DEMO=true
TENDER_MODEL_PROVIDER=offline
# Optional live specialist reasoning. Explicit model required; no provider is called by default.
# TENDER_MODEL_PROVIDER=anthropic
# TENDER_MODEL_NAME=your-approved-model
# TENDER_MODEL_API_KEY=
# TENDER_MODEL_BASE_URL=https://api.anthropic.com
# Production requires API keys; keep this value server-side.
# TENDER_MODE=production
# TENDER_SEED_DEMO=false
# TENDER_DATABASE_URL=postgresql+psycopg://tender:password@localhost:5432/tender
# TENDER_API_KEYS={"replace-with-secret":{"tenant":"department-a","user":"engineer","role":"admin"}}
# Optional semantic embeddings (HTTP endpoint receives {"texts": [...]} and returns {"vectors": [[...]]}).
# TENDER_EMBEDDING_URL=https://approved-internal-service/embed
# TENDER_EMBEDDING_KEY=
# Optional NVIDIA RAG and specialist reviews. Set RAG true only after selecting embedding and rerank models.
# TENDER_MODEL_PROVIDER=nvidia
# TENDER_NVIDIA_API_KEY=
# TENDER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# TENDER_NVIDIA_CHAT_MODEL=
# TENDER_NVIDIA_EMBEDDING_MODEL=
# TENDER_NVIDIA_RERANK_MODEL=
# TENDER_RAG_ENABLED=false
# Optional web discovery through Brave Search; public queries are assembled from catalog fields only.
# TENDER_WEB_ENABLED=true
# TENDER_WEB_SEARCH_KEY=
# TENDER_WEB_ALLOWED_HOSTS=["cpwd.gov.in","doe.gov.in","indianrailways.gov.in"]
# Optional content-addressed S3 storage; enable bucket versioning separately.
# TENDER_OBJECT_BACKEND=s3
# TENDER_S3_BUCKET=tender-artifacts
# TENDER_S3_ENDPOINT_URL=http://localhost:9000
